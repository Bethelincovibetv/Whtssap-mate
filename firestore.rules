rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128; 
    }

    function incoming() { 
      return request.resource.data; 
    }

    function existing() { 
      return resource.data; 
    }

    function isSignedIn() { 
      return request.auth != null && request.auth.uid != null; 
    }

    function isOwner(userId) { 
      return isSignedIn() && request.auth.uid == userId; 
    }

    function isAdmin() { 
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email in ['bethelmbaneto@gmail.com', 'bethelgoodgift3@gmail.com']
      ); 
    }

    // Entity Validators
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'isAdmin', 'totalEarned', 'totalAdsPublished', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 256 &&
        data.role in ['admin', 'promoter', 'advertiser', 'user'];
    }

    function isValidConnectedInstance(data) {
      return data.keys().hasAll(['instanceId', 'ownerUid', 'phone', 'status']) &&
        data.instanceId is string && data.instanceId.size() <= 128 &&
        data.ownerUid is string && data.ownerUid.size() <= 128 &&
        data.phone is string && data.phone.size() <= 32 &&
        data.status is string && data.status.size() <= 32;
    }

    function isValidPooledGroup(data) {
      return data.keys().hasAll(['id', 'instanceId', 'ownerUid', 'subject', 'isEnabled']) &&
        data.id is string && data.id.size() <= 128 &&
        data.instanceId is string && data.instanceId.size() <= 128 &&
        data.ownerUid is string && data.ownerUid.size() <= 128 &&
        data.subject is string && data.subject.size() <= 256 &&
        data.isEnabled is bool;
    }

    function isValidAdvert(data) {
      return data.keys().hasAll(['id', 'creatorUid', 'title', 'advertContent', 'status', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.creatorUid is string && data.creatorUid.size() <= 128 &&
        data.title is string && data.title.size() <= 256 &&
        data.advertContent is string && data.advertContent.size() <= 10000 &&
        data.status in ['pending', 'approved', 'active', 'completed', 'rejected'];
    }

    function isValidCampaign(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'templateText', 'enabled']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.name is string && data.name.size() <= 256 &&
        data.templateText is string && data.templateText.size() <= 10000 &&
        data.enabled is bool;
    }

    function isValidAdvertPitch(data) {
      return data.keys().hasAll(['id', 'targetHostUid', 'title', 'advertContent', 'status', 'submittedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.targetHostUid is string && data.targetHostUid.size() <= 128 &&
        data.title is string && data.title.size() <= 256 &&
        data.advertContent is string && data.advertContent.size() <= 10000 &&
        data.status in ['pending_approval', 'approved', 'rejected'];
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create: if isValidUserProfile(incoming()) && (isSignedIn() ? (isOwner(userId) && incoming().uid == request.auth.uid) : true);
      allow update: if (
        isAdmin() || 
        (isValidUserProfile(incoming()) && (isSignedIn() ? (isOwner(userId) && incoming().uid == existing().uid) : true))
      );
      allow delete: if isAdmin();

      // User campaigns subcollection
      match /campaigns/{campaignId} {
        allow read: if isSignedIn() ? (isOwner(userId) || isAdmin()) : true;
        allow create: if isValidCampaign(incoming()) && (isSignedIn() ? (isOwner(userId) && incoming().userId == request.auth.uid) : true);
        allow update: if isValidCampaign(incoming()) && (isSignedIn() ? (isOwner(userId) && incoming().userId == existing().userId) : true);
        allow delete: if isSignedIn() ? (isOwner(userId) || isAdmin()) : true;
      }
    }

    // 2. Admins Collection
    match /admins/{adminId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Connected Instances (WhatsApp sessions synced to cloud)
    match /instances/{instanceId} {
      allow read: if true;
      allow create: if isValidConnectedInstance(incoming()) && (isSignedIn() ? (incoming().ownerUid == request.auth.uid || isAdmin()) : true);
      allow update: if isValidConnectedInstance(incoming()) && (isSignedIn() ? (existing().ownerUid == request.auth.uid || isAdmin()) : true);
      allow delete: if isSignedIn() ? (existing().ownerUid == request.auth.uid || isAdmin()) : true;
    }

    // 4. Pooled Groups (Public WhatsApp Groups in Ad Network)
    match /pooled_groups/{groupId} {
      allow read: if true;
      allow create: if isValidPooledGroup(incoming()) && (isSignedIn() ? (incoming().ownerUid == request.auth.uid || isAdmin()) : true);
      allow update: if isValidPooledGroup(incoming()) && (isSignedIn() ? (existing().ownerUid == request.auth.uid || isAdmin()) : true);
      allow delete: if isSignedIn() ? (existing().ownerUid == request.auth.uid || isAdmin()) : true;
    }

    // 5. Adverts (Community Adverts & Business Campaigns)
    match /adverts/{advertId} {
      allow read: if true;
      allow create: if isValidAdvert(incoming()) && (isSignedIn() ? (incoming().creatorUid == request.auth.uid || isAdmin()) : true);
      allow update: if isValidAdvert(incoming()) && (
        isAdmin() || 
        (isSignedIn() ? (existing().creatorUid == request.auth.uid && incoming().creatorUid == existing().creatorUid) : true)
      );
      allow delete: if isSignedIn() ? (existing().creatorUid == request.auth.uid || isAdmin()) : true;
    }

    // 6. Global Campaigns Collection (for background cloud execution and syncing)
    match /campaigns/{campaignId} {
      allow read: if true;
      allow create: if isValidCampaign(incoming()) && (isSignedIn() ? (incoming().userId == request.auth.uid || isAdmin()) : true);
      allow update: if isValidCampaign(incoming()) && (
        isAdmin() || 
        (isSignedIn() ? (existing().userId == request.auth.uid && incoming().userId == existing().userId) : true)
      );
      allow delete: if isSignedIn() ? (existing().userId == request.auth.uid || isAdmin()) : true;
    }

    // 7. Platform Feature Configs (Managed exclusively by Admin)
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. Inbound Sponsor & Advert Pitches (Submitted via personal promoter link)
    match /advert_pitches/{pitchId} {
      allow read: if true;
      allow create: if isValidAdvertPitch(incoming());
      allow update: if isValidAdvertPitch(incoming()) && (
        isAdmin() || 
        (isSignedIn() && (resource.data.targetHostUid == request.auth.uid || incoming().targetHostUid == request.auth.uid))
      );
      allow delete: if isSignedIn() && (resource.data.targetHostUid == request.auth.uid || isAdmin());
    }

  }
}
