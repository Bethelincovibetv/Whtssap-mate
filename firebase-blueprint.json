{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role-based access for promoters, advertisers and admins",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "role": { "type": "string", "enum": ["admin", "promoter", "advertiser", "user"], "maxLength": 32 },
        "isAdmin": { "type": "boolean" },
        "totalEarned": { "type": "number" },
        "totalAdsPublished": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted admin authorization document for privileged network operations",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 256 },
        "role": { "type": "string", "maxLength": 32 },
        "grantedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "ConnectedInstance": {
      "title": "ConnectedInstance",
      "description": "WhatsApp connected instance participating in the ad network",
      "type": "object",
      "properties": {
        "instanceId": { "type": "string", "maxLength": 128 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "ownerEmail": { "type": "string", "maxLength": 256 },
        "phone": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "maxLength": 32 },
        "groupsCount": { "type": "number" },
        "pooledGroupsCount": { "type": "number" },
        "totalAudienceReach": { "type": "number" },
        "autoAdPoolEnabled": { "type": "boolean" },
        "lastActive": { "type": "string", "format": "date-time" }
      },
      "required": ["instanceId", "ownerUid", "phone", "status"]
    },
    "PooledGroup": {
      "title": "PooledGroup",
      "description": "Public WhatsApp group opted into automated ad campaign distribution",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "instanceId": { "type": "string", "maxLength": 128 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "ownerEmail": { "type": "string", "maxLength": 256 },
        "subject": { "type": "string", "maxLength": 256 },
        "participantsCount": { "type": "number" },
        "isBotAdmin": { "type": "boolean" },
        "isOpenForMessages": { "type": "boolean" },
        "isEnabled": { "type": "boolean" },
        "category": { "type": "string", "maxLength": 64 },
        "tags": { "type": "array" },
        "addedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "instanceId", "ownerUid", "subject", "isEnabled"]
    },
    "AdvertCampaign": {
      "title": "AdvertCampaign",
      "description": "General advertising campaign submitted for network distribution",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "creatorUid": { "type": "string", "maxLength": 128 },
        "creatorEmail": { "type": "string", "maxLength": 256 },
        "creatorName": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "advertContent": { "type": "string", "maxLength": 5000 },
        "linkUrl": { "type": "string", "maxLength": 1024 },
        "mediaUrl": { "type": "string", "maxLength": 1024 },
        "musicUrl": { "type": "string", "maxLength": 1024 },
        "category": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["pending", "approved", "active", "completed", "rejected"], "maxLength": 32 },
        "budget": { "type": "number" },
        "targetReach": { "type": "number" },
        "deliveredGroupsCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "approvedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "creatorUid", "title", "advertContent", "status", "createdAt"]
    },
    "UserCampaign": {
      "title": "UserCampaign",
      "description": "Automated WhatsApp broadcast campaign stored in Firebase under user account",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 256 },
        "name": { "type": "string", "maxLength": 256 },
        "targetMode": { "type": "string", "maxLength": 64 },
        "targetGroupJids": { "type": "array" },
        "targetContactJids": { "type": "array" },
        "targetTags": { "type": "array" },
        "templateText": { "type": "string", "maxLength": 10000 },
        "imageUrl": { "type": "string", "maxLength": 5000000 },
        "minDelaySec": { "type": "number" },
        "maxDelaySec": { "type": "number" },
        "batchSize": { "type": "number" },
        "batchPauseMinutes": { "type": "number" },
        "repeatEnabled": { "type": "boolean" },
        "repeatIntervalMinutes": { "type": "number" },
        "repeatIntervalHours": { "type": "number" },
        "maxIterations": { "type": "number" },
        "currentIteration": { "type": "number" },
        "enabled": { "type": "boolean" },
        "accountId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastRunAt": { "type": "string", "format": "date-time" },
        "nextRunAt": { "type": "string" },
        "lastRunStatus": { "type": "string", "maxLength": 32 }
      },
      "required": ["id", "userId", "name", "templateText", "enabled"]
    },
    "AdvertPitch": {
      "title": "AdvertPitch",
      "description": "External client advert pitch submitted to a promoter's personal link",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "targetHostUid": { "type": "string", "maxLength": 128 },
        "targetHostEmail": { "type": "string", "maxLength": 256 },
        "title": { "type": "string", "maxLength": 256 },
        "advertContent": { "type": "string", "maxLength": 10000 },
        "linkUrl": { "type": "string", "maxLength": 2048 },
        "mediaUrl": { "type": "string" },
        "submitterName": { "type": "string", "maxLength": 128 },
        "submitterContact": { "type": "string", "maxLength": 256 },
        "category": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["pending_approval", "approved", "rejected"], "maxLength": 32 },
        "submittedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "targetHostUid", "title", "advertContent", "status", "submittedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles and promoter account state"
    },
    "/users/{userId}/campaigns/{campaignId}": {
      "schema": "UserCampaign",
      "description": "User specific broadcast campaigns persisted securely in Firebase"
    },
    "/admins/{adminId}": {
      "schema": "AdminRecord",
      "description": "Admin authorization table containing bethelmbaneto@gmail.com and bethelgoodgift3@gmail.com"
    },
    "/instances/{instanceId}": {
      "schema": "ConnectedInstance",
      "description": "Live connected WhatsApp accounts synced to cloud"
    },
    "/pooled_groups/{groupId}": {
      "schema": "PooledGroup",
      "description": "Groups contributed to the public automated ad network"
    },
    "/adverts/{advertId}": {
      "schema": "AdvertCampaign",
      "description": "Public and business advert campaigns for automated distribution"
    },
    "/advert_pitches/{pitchId}": {
      "schema": "AdvertPitch",
      "description": "Client advert pitches submitted through personal promoter link for approval"
    },
    "/campaigns/{campaignId}": {
      "schema": "UserCampaign",
      "description": "Global campaigns registry for cloud dispatch and multi-account auto-poster"
    },
    "/config/{configId}": {
      "schema": "PlatformFeatureConfig",
      "description": "Global feature visibility toggles controlled by administrator"
    }
  }
}
